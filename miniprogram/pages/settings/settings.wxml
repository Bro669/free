<view class="page">
  <view class="card set__group">
    <view class="set__item" data-type="user" bindtap="openAgreement">
      <text class="set__icon">📄</text>
      <text class="set__name">用户协议</text>
      <text class="set__arrow">›</text>
    </view>
    <view class="set__item" data-type="privacy" bindtap="openAgreement">
      <text class="set__icon">🔒</text>
      <text class="set__name">隐私协议</text>
      <text class="set__arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="container">
    <button class="set__logout" bindtap="confirmLogout">退出登录</button>
  </view>

  <!-- 退出确认弹窗 -->
  <view wx:if="{{showLogoutConfirm}}" class="dialog-mask" bindtap="cancelLogout">
    <view class="dialog" catchtap="">
      <view class="dialog__icon">↩</view>
      <view class="dialog__title">确认退出当前账号？</view>
      <view class="dialog__btns">
        <view class="dialog__btn dialog__btn--cancel" bindtap="cancelLogout">取消</view>
        <view class="dialog__btn dialog__btn--ok" bindtap="doLogout">确认退出</view>
      </view>
    </view>
  </view>
</view>
