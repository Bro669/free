.stats-card {
  display: flex;
  background: linear-gradient(160deg, #10241B, #1B5E43);
  color: #fff;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.65;
  margin-top: 6rpx;
}

.collect-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.collect-sub {
  font-size: 22rpx;
  color: #8A938E;
  font-weight: 400;
}

.letter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.letter {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #F0F3F1;
  color: #C2C9C5;
  font-size: 28rpx;
  font-weight: 700;
}

.letter.got {
  background: #19C37D;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(25, 195, 125, 0.35);
}

.extras {
  margin-top: 20rpx;
}

.extra-chip {
  display: inline-block;
  padding: 4rpx 18rpx;
  margin-right: 12rpx;
  background: #FFF3E5;
  color: #E08A2E;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 8rpx 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #8A938E;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #19C37D;
  font-weight: 600;
  border-bottom-color: #19C37D;
}

.item {
  display: flex;
  align-items: center;
}

.item-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #F4F7F5;
  flex-shrink: 0;
}

.item-badge {
  min-width: 110rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 14rpx;
  text-align: center;
  background: #E9F9F1;
  color: #0E9F66;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.item-badge.ride {
  background: #FFF3E5;
  color: #E08A2E;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.private {
  font-size: 20rpx;
  color: #8A938E;
  border: 2rpx solid #D8DEDA;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.item-meta {
  font-size: 24rpx;
  color: #8A938E;
  margin-top: 8rpx;
}

.arrow {
  color: #C2C9C5;
  font-size: 44rpx;
}

.empty-btn {
  width: 320rpx;
  margin: 32rpx auto 0;
}
