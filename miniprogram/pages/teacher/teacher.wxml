<view class="page container" wx:if="{{info}}">
  <!-- 年级班级 -->
  <view class="teacher__top">
    <view class="teacher__top-item">
      <view class="teacher__top-label">年级名称</view>
      <view class="teacher__top-value">{{info.grade}}</view>
    </view>
    <view class="teacher__top-item">
      <view class="teacher__top-label">班级名称</view>
      <view class="teacher__top-value">{{info.className}}</view>
    </view>
  </view>

  <!-- 班主任 -->
  <view class="teacher__section-title">👤 班主任</view>
  <view class="card head-teacher">
    <view class="avatar avatar--lg">{{info.headTeacher.avatar ? '' : '师'}}</view>
    <view class="head-teacher__info">
      <view class="head-teacher__name">
        {{info.headTeacher.name}}
        <text class="head-teacher__tag">任教：{{info.headTeacher.subject}}</text>
      </view>
      <view class="head-teacher__meta">{{info.headTeacher.gender}} · {{info.headTeacher.degree}} · {{info.headTeacher.title}}</view>
    </view>
  </view>

  <!-- 任课教师 -->
  <view class="teacher__section-title">👥 任课教师 <text class="teacher__count">共{{info.teachers.length}}名</text></view>
  <view class="teacher__grid">
    <view class="card teacher__card" wx:for="{{info.teachers}}" wx:key="name">
      <view class="teacher__subject">{{item.subject}}</view>
      <view class="avatar">{{item.avatar ? '' : '师'}}</view>
      <view class="teacher__name">{{item.name}}</view>
      <view class="teacher__meta">{{item.gender}} · {{item.degree}}</view>
      <view class="teacher__meta">{{item.title}}</view>
    </view>
  </view>
</view>
