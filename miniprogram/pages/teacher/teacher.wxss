.teacher__top {
  display: flex;
  background: var(--gradient-primary);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.teacher__top-item { flex: 1; text-align: center; }
.teacher__top-label { font-size: 24rpx; opacity: 0.9; }
.teacher__top-value { font-size: 30rpx; font-weight: 700; margin-top: 12rpx; }

.teacher__section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}
.teacher__count { font-size: 24rpx; color: var(--color-text-placeholder); font-weight: 400; }

.avatar {
  width: 88rpx; height: 88rpx; line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFF4E8;
  color: var(--color-primary);
  font-size: 30rpx;
}
.avatar--lg { width: 100rpx; height: 100rpx; line-height: 100rpx; }

.head-teacher { display: flex; align-items: center; }
.head-teacher__info { margin-left: 24rpx; flex: 1; }
.head-teacher__name { font-size: 32rpx; font-weight: 600; }
.head-teacher__tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: #FFF4E8;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  font-weight: 400;
}
.head-teacher__meta { font-size: 24rpx; color: var(--color-text-placeholder); margin-top: 12rpx; }

.teacher__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.teacher__card {
  width: 48%;
  text-align: center;
  position: relative;
  padding-top: 40rpx;
}
.teacher__card .avatar { margin: 0 auto; }
.teacher__subject {
  position: absolute;
  top: 0; right: 0;
  font-size: 22rpx;
  color: var(--color-primary);
  background: #FFF4E8;
  padding: 6rpx 20rpx;
  border-radius: 0 20rpx 0 20rpx;
}
.teacher__name { font-size: 30rpx; font-weight: 600; margin-top: 16rpx; }
.teacher__meta { font-size: 22rpx; color: var(--color-text-placeholder); margin-top: 6rpx; }
