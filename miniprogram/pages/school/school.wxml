<view class="page" wx:if="{{school}}">
  <!-- 学校头部 -->
  <view class="school__hero">
    <view class="school__logo">{{school.logo ? '' : '🏫'}}</view>
    <view class="school__name">{{school.name}}</view>
  </view>

  <!-- Tab -->
  <view class="school__tabs">
    <view class="school__tab {{activeTab===index?'is-active':''}}"
      wx:for="{{school.tabs}}" wx:key="key" data-index="{{index}}" bindtap="switchTab">
      {{item.title}}
    </view>
  </view>

  <!-- 内容 -->
  <view class="card school__content">
    <text class="school__text">{{school.tabs[activeTab].content}}</text>
  </view>
</view>
