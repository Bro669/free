.school__hero {
  background: var(--gradient-primary);
  padding: 56rpx 0 70rpx;
  text-align: center;
  color: #fff;
}
.school__logo {
  width: 130rpx; height: 130rpx; line-height: 130rpx;
  margin: 0 auto 20rpx;
  font-size: 70rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
}
.school__name { font-size: 38rpx; font-weight: 700; }

.school__tabs {
  display: flex;
  background: #fff;
  margin: -40rpx 24rpx 0;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.school__tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  position: relative;
}
.school__tab.is-active {
  color: var(--color-primary);
  font-weight: 600;
}
.school__tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 12rpx; left: 50%;
  transform: translateX(-50%);
  width: 48rpx; height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.school__content { margin: 24rpx; }
.school__text {
  font-size: 28rpx;
  line-height: 52rpx;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}
