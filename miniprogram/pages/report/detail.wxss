.rd__header {
  background: var(--gradient-primary);
  color: #fff;
  padding: 40rpx;
}
.rd__name { font-size: 36rpx; font-weight: 700; }
.rd__time { font-size: 24rpx; opacity: 0.9; margin-top: 12rpx; }

.card { margin: 24rpx; }
.rd__section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--color-primary);
}
.rd__summary { font-size: 28rpx; line-height: 50rpx; color: var(--color-text-secondary); }

.rd__radar {
  width: 100%;
  height: 480rpx;
}
.rd__dims {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--color-line);
  padding-top: 12rpx;
  margin-top: 8rpx;
}
.rd__dim {
  width: 33.33%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}
.rd__dim-name { font-size: 24rpx; color: var(--color-text-secondary); margin-right: 10rpx; }
.rd__dim-value { font-size: 28rpx; }
