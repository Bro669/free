.rp-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
}
.rp-filter {
  font-size: 28rpx;
  color: var(--color-text);
  background: #F2F3F5;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}
.rp-interpret { font-size: 26rpx; color: #3B6EF5; }

.rp-item { display: flex; align-items: center; }
.rp-item__cover {
  width: 150rpx; height: 110rpx; line-height: 110rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFE3C2, #FFD0A6);
  color: #C9772E;
  border-radius: 14rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}
.rp-item__body { flex: 1; min-width: 0; }
.rp-item__name { font-size: 30rpx; font-weight: 600; }
.rp-item__time { font-size: 24rpx; color: var(--color-text-placeholder); margin-top: 14rpx; }
.rp-item__btn {
  font-size: 24rpx;
  color: #fff;
  background: var(--gradient-primary);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.rp-item__btn.is-gen { color: #999; background: #F0F0F0; }

.empty__icon-emoji { font-size: 120rpx; margin-bottom: 20rpx; opacity: 0.7; }
