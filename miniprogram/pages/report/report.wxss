.report-item {
  display: flex;
  align-items: center;
}
.report-item__cover {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  text-align: center;
  font-size: 48rpx;
  background: #FFF4E8;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.report-item__body { flex: 1; min-width: 0; }
.report-item__name { font-size: 30rpx; font-weight: 600; }
.report-item__time { font-size: 24rpx; color: var(--color-text-placeholder); margin-top: 12rpx; }
.report-item__status {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.report-item__status.is-done { color: var(--color-primary); background: #FFF4E8; }
.report-item__status.is-generating { color: #999; background: #F2F3F5; }

.empty__icon-emoji { font-size: 120rpx; margin-bottom: 20rpx; opacity: 0.7; }
