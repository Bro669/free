.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.map {
  flex: 1;
  width: 100%;
}

.card {
  margin: 0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.meta {
  display: flex;
  margin-bottom: 28rpx;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-num {
  font-size: 32rpx;
  font-weight: 600;
}

.meta-label {
  font-size: 22rpx;
  color: #8A938E;
  margin-top: 6rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.flex1 { flex: 1; }

.danger { color: #FF5A5F; border-color: #FFD3D4; }
