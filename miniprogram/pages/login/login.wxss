.login {
  min-height: 100vh;
  position: relative;
  padding: 0 60rpx;
  overflow: hidden;
}
.login__bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 100vh;
  background: linear-gradient(180deg, #FFE8CC 0%, #FFF6EC 40%, #F5F6F8 100%);
  z-index: -1;
}

.login__brand {
  padding-top: 220rpx;
  text-align: center;
  margin-bottom: 100rpx;
}
.login__logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 24rpx;
  font-size: 80rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 138, 0, 0.25);
}
.login__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7A00;
}
.login__slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #C8884B;
}

.login__card { margin-bottom: 40rpx; }

.login__field {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}
.login__field-icon { font-size: 34rpx; margin-right: 16rpx; }
.login__input { flex: 1; font-size: 30rpx; }
.login__code-btn {
  font-size: 26rpx;
  color: #FF7A00;
  padding-left: 24rpx;
  border-left: 1rpx solid #eee;
}
.login__code-btn.is-disabled { color: #bbb; }

.login__btn { margin-top: 12rpx; }
.login__alt {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #FF7A00;
}

.login__agree {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.login__check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.login__check.is-checked {
  background: #FF8C28;
  border-color: #FF8C28;
  position: relative;
}
.login__check.is-checked::after {
  content: '';
  position: absolute;
  left: 10rpx; top: 5rpx;
  width: 8rpx; height: 14rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.login__agree-text { line-height: 36rpx; }
