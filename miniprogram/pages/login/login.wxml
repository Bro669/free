<view class="login">
  <view class="login__bg"></view>

  <view class="login__brand">
    <view class="login__logo">🍊</view>
    <view class="login__title">一支橙家长端</view>
    <view class="login__slogan">陪伴每一次成长</view>
  </view>

  <view class="login__card">
    <!-- 微信一键登录 -->
    <block wx:if="{{mode === 'wechat'}}">
      <button class="btn-primary login__btn" loading="{{submitting}}" bindtap="wechatLogin">微信一键登录</button>
      <view class="login__alt" data-mode="sms" bindtap="switchMode">手机号验证码登录</view>
    </block>

    <!-- 手机验证码登录 -->
    <block wx:else>
      <view class="login__field">
        <text class="login__field-icon">📱</text>
        <input class="login__input" type="number" maxlength="11" placeholder="请输入手机号"
          data-field="phone" value="{{phone}}" bindinput="onInput" />
      </view>
      <view class="login__field">
        <text class="login__field-icon">🔒</text>
        <input class="login__input" type="number" maxlength="6" placeholder="请输入验证码"
          data-field="code" value="{{code}}" bindinput="onInput" />
        <view class="login__code-btn {{counting>0?'is-disabled':''}}" bindtap="sendCode">
          {{counting > 0 ? counting + 's' : '获取验证码'}}
        </view>
      </view>
      <button class="btn-primary login__btn" loading="{{submitting}}" bindtap="smsLogin">登 录</button>
      <view class="login__alt" data-mode="wechat" bindtap="switchMode">微信一键登录</view>
    </block>
  </view>

  <view class="login__agree">
    <view class="login__check {{agree?'is-checked':''}}" bindtap="toggleAgree"></view>
    <view class="login__agree-text">
      已阅读并同意
      <text class="text-primary" data-type="user" catchtap="openAgreement">《用户协议》</text>
      和
      <text class="text-primary" data-type="privacy" catchtap="openAgreement">《隐私协议》</text>
    </view>
  </view>
</view>
