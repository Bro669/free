.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.thumb-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}

.map {
  flex: 1;
  width: 100%;
}

.crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
  color: #FF5A5F;
  font-weight: bold;
}

.move-hint {
  position: absolute;
  left: 50%;
  top: 24rpx;
  transform: translateX(-50%);
  background: rgba(16, 36, 27, 0.75);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
}

.panel {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(16, 36, 27, 0.08);
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.warn { color: #FF9F40; font-size: 26rpx; font-weight: 400; }

.text-input {
  background: #F4F6F5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 36rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.tip {
  color: #8A938E;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.chip {
  padding: 10rpx 30rpx;
  background: #E9F9F1;
  color: #0E9F66;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.score {
  font-size: 26rpx;
  margin-left: 12rpx;
  font-weight: 600;
}
.score.good { color: #19C37D; }
.score.mid { color: #E0A23C; }
.score.low { color: #FF5A5F; }

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 220rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.slider { flex: 1; margin: 0; }

.dist {
  flex: 1;
  text-align: right;
  color: #8A938E;
  font-size: 24rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.flex1 { flex: 1; }
.flex2 { flex: 2; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}
