<view class="page archive" wx:if="{{isLogin && detail}}">
  <!-- 章节导航 -->
  <view class="nav">
    <view class="nav__head">
      <view class="nav__title"><text class="nav__bar"></text>章节导航</view>
      <view class="nav__interpret" bindtap="openInterpret">💬 成长档案解读</view>
    </view>
    <view class="nav__chips">
      <view class="nav__chip {{activeChapter===item.key?'is-active':''}}"
        wx:for="{{detail.chapters}}" wx:key="key" data-key="{{item.key}}" bindtap="switchChapter">
        {{item.title}}
      </view>
    </view>
  </view>

  <!-- 章节内容 -->
  <view class="content">
    <!-- 封面 -->
    <view wx:if="{{activeChapter==='cover'}}" class="cover">
      <view class="cover__brand">🍊 一支橙</view>
      <view class="cover__school">{{detail.student.school}}</view>
      <view class="cover__cn">生涯成长档案</view>
      <view class="cover__en">CAREER GROWTH PROFILE</view>
      <view class="cover__info">
        <view>姓名：{{detail.student.name}}</view>
        <view>班级：{{detail.student.className}}</view>
      </view>
    </view>

    <!-- 前言 -->
    <view wx:elif="{{activeChapter==='preface'}}" class="card doc">
      <view class="doc__title">前言</view>
      <view class="doc__text">{{detail.preface}}</view>
    </view>

    <!-- 目录 -->
    <view wx:elif="{{activeChapter==='catalog'}}" class="card doc">
      <view class="doc__title">目录</view>
      <view class="catalog__item" wx:for="{{detail.catalog}}" wx:key="*this">
        <text class="catalog__no">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>
        <text class="catalog__name">{{item}}</text>
      </view>
    </view>

    <!-- 我的画像 -->
    <view wx:elif="{{activeChapter==='portrait'}}" class="card doc">
      <view class="doc__title">我的画像</view>
      <view class="kv" wx:for="{{detail.portrait}}" wx:key="label">
        <text class="kv__label">{{item.label}}</text>
        <text class="kv__value">{{item.value}}</text>
      </view>
    </view>

    <!-- 自我认知篇 -->
    <view wx:elif="{{activeChapter==='cognition'}}" class="card doc">
      <view class="doc__title">自我认知篇</view>
      <view class="doc__text">{{detail.cognition}}</view>
    </view>

    <!-- 环境探索篇 -->
    <view wx:elif="{{activeChapter==='explore'}}" class="card doc">
      <view class="doc__title">环境探索篇</view>
      <view class="doc__text">{{detail.explore}}</view>
    </view>

    <!-- 我的梦想清单 -->
    <view wx:elif="{{activeChapter==='dream'}}" class="card doc">
      <view class="doc__title">我的梦想清单</view>
      <view class="dream__item" wx:for="{{detail.dream}}" wx:key="*this">
        <text class="dream__check">✓</text>{{item}}
      </view>
    </view>

    <!-- 学业战绩 -->
    <view wx:elif="{{activeChapter==='score'}}" class="score-chapter">
      <view class="score-banner">
        <view class="score-banner__cn">学业战绩</view>
        <view class="score-banner__en">ACADEMIC ACHIEVEMENTS</view>
      </view>
      <view class="card score-list">
        <view class="score-list__title">成绩列表</view>
        <view class="exam" wx:for="{{detail.scoreTable.records}}" wx:for-item="rec" wx:key="examName">
          <view class="exam__meta">
            考试名称：{{rec.examName}}　类型：{{rec.examType}}　{{rec.term}}　{{rec.date}}
          </view>
          <scroll-view scroll-x class="exam__scroll">
            <view class="tbl">
              <view class="tbl__row tbl__row--head">
                <text class="tbl__cell tbl__cell--first">科目</text>
                <text class="tbl__cell" wx:for="{{detail.scoreTable.subjects}}" wx:for-item="sub" wx:key="*this">{{sub}}</text>
                <text class="tbl__cell">总成绩</text>
                <text class="tbl__cell">班级排名</text>
                <text class="tbl__cell">年级排名</text>
              </view>
              <view class="tbl__row">
                <text class="tbl__cell tbl__cell--first">分数</text>
                <text class="tbl__cell" wx:for="{{rec.scores}}" wx:key="*this">{{item}}</text>
                <text class="tbl__cell tbl__cell--total">{{rec.total}}</text>
                <text class="tbl__cell">{{rec.classRank}}</text>
                <text class="tbl__cell">{{rec.gradeRank}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 未登录 -->
<view wx:if="{{!isLogin}}" class="empty">
  <view class="empty__icon-emoji">🌱</view>
  <view class="empty__text">登录后查看孩子的成长档案</view>
  <button class="btn-primary archive__login-btn" bindtap="goLogin">去登录</button>
</view>
