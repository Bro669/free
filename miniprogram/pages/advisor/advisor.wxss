.advisor__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 24rpx;
}
.advisor__q { font-size: 28rpx; color: var(--color-text-secondary); line-height: 56rpx; }
.advisor__add { font-size: 30rpx; margin: 24rpx 0 16rpx; }
.advisor__benefit { font-size: 28rpx; color: var(--color-text-secondary); line-height: 56rpx; }
.advisor__check {
  color: var(--color-success);
  margin-right: 12rpx;
  font-weight: 700;
}

.advisor__qr-card { text-align: center; }
.advisor__online { font-size: 26rpx; color: var(--color-text-secondary); }
.advisor__dot {
  display: inline-block;
  width: 14rpx; height: 14rpx;
  background: var(--color-success);
  border-radius: 50%;
  margin-right: 10rpx;
}
.advisor__qr {
  width: 360rpx; height: 360rpx;
  margin: 32rpx auto;
  border: 2rpx dashed var(--color-primary);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFCF8;
}
.advisor__qr-placeholder { color: var(--color-text-placeholder); font-size: 28rpx; }
.advisor__qr-tip {
  display: inline-block;
  font-size: 26rpx;
  color: var(--color-primary);
  background: #FFF4E8;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
}
.advisor__foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  margin-top: 40rpx;
}
