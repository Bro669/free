.card { margin: 24rpx; }
.about__brand { text-align: center; padding: 48rpx 28rpx; }
.about__logo {
  width: 130rpx; height: 130rpx; line-height: 130rpx;
  margin: 0 auto 20rpx;
  font-size: 72rpx;
  background: #FFF4E8;
  border-radius: 32rpx;
}
.about__name { font-size: 36rpx; font-weight: 700; }
.about__intro {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 46rpx;
  margin-top: 24rpx;
  text-align: left;
}

.about__section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.about__row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.about__row:last-child { border-bottom: none; }
.about__row-icon { font-size: 34rpx; margin-right: 20rpx; }
.about__row-label { flex: 1; font-size: 28rpx; }
.about__row-value { font-size: 28rpx; color: var(--color-text-secondary); }

.about__copyright {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 60rpx;
}
