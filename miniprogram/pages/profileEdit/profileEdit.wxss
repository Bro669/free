.edit { margin: 24rpx; padding: 0 28rpx; }
.edit__row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.edit__row:last-child { border-bottom: none; }
.edit__label { width: 240rpx; font-size: 30rpx; }
.edit__input { flex: 1; font-size: 30rpx; text-align: right; }
.edit__value { flex: 1; text-align: right; font-size: 30rpx; color: var(--color-text-secondary); }

.edit__block { padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }
.edit__block:last-child { border-bottom: none; }
.edit__block .edit__label { display: block; width: auto; margin-bottom: 16rpx; }
.edit__textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
}
