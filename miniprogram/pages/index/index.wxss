.index { padding: 24rpx 24rpx 40rpx; }

/* 欢迎卡 */
.welcome {
  background: linear-gradient(135deg, #FFF1E0 0%, #FFFFFF 70%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.welcome__badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  color: #FF7A00;
  background: #FFEAD2;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 14rpx;
}
.welcome__greet { font-size: 36rpx; font-weight: 700; color: var(--color-text); }

/* 通知条 */
.notice {
  display: flex;
  align-items: center;
  background: #FFF6EC;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.notice__icon { width: 32rpx; height: 32rpx; margin-right: 14rpx; }
.notice__text { flex: 1; font-size: 24rpx; color: #B36B1E; }

/* 通用 section */
.section { margin-bottom: 24rpx; }
.section__head { display: flex; justify-content: space-between; align-items: center; }
.section__title { display: flex; align-items: center; font-size: 30rpx; font-weight: 700; }
.section__bar {
  width: 8rpx; height: 30rpx; border-radius: 4rpx;
  background: var(--color-primary); margin-right: 14rpx;
}
.section__more { font-size: 26rpx; color: var(--color-text-placeholder); }

/* 快捷入口 */
.quick { display: flex; margin-top: 28rpx; }
.quick__item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick__icon { width: 96rpx; height: 96rpx; }
.quick__name { font-size: 26rpx; color: var(--color-text-secondary); margin-top: 14rpx; }

/* 成长档案完整度 */
.arch-progress {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  font-size: 26rpx;
}
.arch-progress__label { color: var(--color-text-secondary); }
.arch-progress__value { color: var(--color-primary); font-weight: 700; }
.arch-progress__more { margin-left: auto; color: var(--color-text-placeholder); font-size: 24rpx; }

/* 学生卡 */
.stu {
  display: flex;
  align-items: center;
  background: #FAFBFC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.stu__avatar {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff; font-size: 40rpx;
  margin-right: 24rpx; flex-shrink: 0;
}
.stu__body { flex: 1; min-width: 0; }
.stu__name { font-size: 32rpx; font-weight: 700; color: #FF7A00; }
.stu__tags { display: flex; align-items: center; margin-top: 12rpx; flex-wrap: wrap; }
.stu__tag {
  font-size: 22rpx; color: var(--color-text-secondary);
  background: #EEF0F3; border-radius: 6rpx;
  padding: 4rpx 12rpx; margin-right: 12rpx; margin-bottom: 4rpx;
}
.stu__tag--pink { color: #FF5A8A; background: #FFE9F0; }
.stu__tag--blue { color: #3B6EF5; background: #EAF1FF; }
.stu__time { font-size: 22rpx; color: var(--color-text-placeholder); margin-top: 16rpx; }

/* 家长课堂 tab */
.ctab { display: flex; margin: 24rpx 0 8rpx; }
.ctab__item {
  font-size: 26rpx; color: var(--color-text-secondary);
  background: #F2F3F5; border-radius: 999rpx;
  padding: 10rpx 28rpx; margin-right: 18rpx;
}
.ctab__item.is-active { color: #fff; background: var(--color-primary); }

/* 文章项 */
.art {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.art:last-child { border-bottom: none; }
.art__cover {
  width: 150rpx; height: 110rpx; line-height: 110rpx;
  text-align: center;
  background: #F0F2F5; color: #B8BEC8;
  border-radius: 12rpx; font-size: 26rpx;
  margin-right: 20rpx; flex-shrink: 0;
}
.art__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.art__title { font-size: 28rpx; font-weight: 600; line-height: 40rpx; }
.art__time { font-size: 22rpx; color: var(--color-text-placeholder); margin-top: auto; padding-top: 10rpx; }
