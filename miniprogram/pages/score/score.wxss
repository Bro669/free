.score__banner {
  background: var(--gradient-primary);
  padding: 40rpx;
  color: #fff;
  position: relative;
}
.score__banner-cn { font-size: 40rpx; font-weight: 700; }
.score__banner-en { font-size: 22rpx; letter-spacing: 2rpx; opacity: 0.85; margin-top: 6rpx; }
.score__term {
  display: inline-block;
  margin-top: 24rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.25);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.score__summary {
  display: flex;
  margin: -36rpx 24rpx 0;
  text-align: center;
}
.score__summary-item { flex: 1; }
.score__summary-num { font-size: 44rpx; font-weight: 700; color: var(--color-primary); }
.score__summary-label { font-size: 24rpx; color: var(--color-text-placeholder); margin-top: 8rpx; }
.score__summary-divider { width: 1rpx; background: var(--color-line); }
.score__exam { text-align: center; font-size: 24rpx; color: var(--color-text-placeholder); margin: 16rpx 0 24rpx; }

.score__chart-tabs { display: flex; margin-bottom: 30rpx; }
.score__chart-tab {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-right: 40rpx;
  padding-bottom: 8rpx;
}
.score__chart-tab.is-active {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}

/* 柱状图 */
.bar-chart {
  display: flex;
  align-items: flex-end;
  height: 320rpx;
  padding-top: 20rpx;
}
.bar-chart__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-chart__value { font-size: 22rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.bar-chart__bar {
  width: 40rpx;
  background: linear-gradient(180deg, #FFB347, #FF8A00);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
}
.bar-chart__label { font-size: 22rpx; color: var(--color-text-placeholder); margin-top: 12rpx; }

/* 趋势/得分率条 */
.line-chart__row { display: flex; align-items: center; margin-bottom: 26rpx; }
.line-chart__name { width: 80rpx; font-size: 26rpx; }
.line-chart__track {
  flex: 1;
  height: 16rpx;
  background: #F2F3F5;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.line-chart__fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB347, #FF8A00);
  border-radius: 999rpx;
}
.line-chart__pct { width: 70rpx; text-align: right; font-size: 24rpx; color: var(--color-text-secondary); }

/* 明细表 */
.score__list-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.score__row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 28rpx;
}
.score__row:last-child { border-bottom: none; }
.score__row--head { color: var(--color-text-placeholder); font-size: 24rpx; }
.score__c1 { flex: 2; }
.score__c2, .score__c3, .score__c4 { flex: 1.5; text-align: center; }
