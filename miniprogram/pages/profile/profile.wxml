<view class="page" wx:if="{{form}}">
  <!-- 头像 -->
  <view class="pf-avatar">
    <view class="pf-avatar__wrap" bindtap="changeAvatar">
      <image wx:if="{{form.avatar}}" class="pf-avatar__img" src="{{form.avatar}}" mode="aspectFill" />
      <view wx:else class="pf-avatar__ph">{{form.name[0]}}</view>
      <view class="pf-avatar__cam">📷</view>
    </view>
  </view>

  <!-- 基本信息（只读） -->
  <view class="card pf-base">
    <view class="pf-row">
      <text class="pf-label">姓名</text>
      <text class="pf-value text-bold">{{form.name}}</text>
    </view>
    <view class="pf-row pf-row--last">
      <text class="pf-label">手机号码</text>
      <text class="pf-value text-bold">{{form.phone}}</text>
    </view>
  </view>

  <!-- 关系信息 -->
  <view class="pf-sec-head">
    <text class="pf-dot" style="background:#FF5A8A"></text>关系信息
    <text class="pf-edit" data-key="relation" bindtap="editSection">✎</text>
  </view>
  <view class="card">
    <view class="pf-line">家庭关系：{{form.relation}}</view>
  </view>

  <!-- 地址信息 -->
  <view class="pf-sec-head">
    <text class="pf-dot" style="background:#2FB344"></text>地址信息
    <text class="pf-edit" data-key="address" bindtap="editSection">✎</text>
  </view>
  <view class="card">
    <view class="pf-field"><text class="pf-field-label">住址</text><text class="pf-field-value">{{form.province}}</text></view>
    <view class="pf-field"><text class="pf-field-label">详细地址</text><text class="pf-field-value">{{form.addressDetail}}</text></view>
  </view>

  <!-- 职业信息 -->
  <view class="pf-sec-head">
    <text class="pf-dot" style="background:#3B6EF5"></text>职业信息
    <text class="pf-edit" data-key="occupation" bindtap="editSection">✎</text>
  </view>
  <view class="card">
    <view class="pf-field"><text class="pf-field-label">工作单位</text><text class="pf-field-value">{{form.company}}</text></view>
    <view class="pf-field"><text class="pf-field-label">单位类型</text><text class="pf-field-value">{{form.companyType}}</text></view>
    <view class="pf-field"><text class="pf-field-label">所属行业</text><text class="pf-field-value">{{form.industry}}</text></view>
    <view class="pf-field"><text class="pf-field-label">职业类别</text><text class="pf-field-value">{{form.jobCategory}}</text></view>
    <view class="pf-field"><text class="pf-field-label">职业名称</text><text class="pf-field-value">{{form.jobTitle}}</text></view>
    <view class="pf-field"><text class="pf-field-label">工作年限</text><text class="pf-field-value">{{form.workYears}}</text></view>
    <view class="pf-field"><text class="pf-field-label">年收入</text><text class="pf-field-value">{{form.income}}</text></view>
  </view>

  <!-- 毕业院校 -->
  <view class="pf-sec-head">
    <text class="pf-dot" style="background:#8B5CF6"></text>毕业院校
    <text class="pf-edit" data-key="school" bindtap="editSection">✎</text>
  </view>
  <view class="card">
    <view class="pf-field"><text class="pf-field-label">毕业院校</text><text class="pf-field-value">{{form.graduateSchool}}</text></view>
    <view class="pf-field"><text class="pf-field-label">毕业专业</text><text class="pf-field-value">{{form.graduateMajor}}</text></view>
  </view>

  <!-- 分享意愿 -->
  <view class="pf-sec-head">
    <text class="pf-dot" style="background:#FF8A00"></text>分享意愿
    <text class="pf-edit" data-key="share" bindtap="editSection">✎</text>
  </view>
  <view class="card pf-share">
    <view class="pf-line">是否愿意分享职场经验：{{form.willShare}}</view>
    <view class="pf-share-item">对专业的看法：<text class="text-bold">{{form.viewMajor}}</text></view>
    <view class="pf-share-item">对职业的看法：<text class="text-bold">{{form.viewJob}}</text></view>
  </view>
</view>
