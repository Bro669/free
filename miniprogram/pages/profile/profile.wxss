.profile { margin: 24rpx; padding: 0 28rpx; }
.profile__row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.profile__row--last { border-bottom: none; }
.profile__label { width: 200rpx; font-size: 30rpx; color: var(--color-text); }
.profile__input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}
.profile__value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}
.profile__value--readonly { color: var(--color-text-placeholder); }

.profile__row--avatar { justify-content: space-between; }
.profile__avatar {
  width: 88rpx; height: 88rpx; line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 36rpx;
}
