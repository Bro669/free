.msg-filter {
  display: flex;
  background: #fff;
  padding: 20rpx 24rpx;
}
.msg-filter__item {
  padding: 12rpx 36rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 999rpx;
  margin-right: 20rpx;
  background: #F2F3F5;
}
.msg-filter__item.is-active {
  color: #fff;
  background: var(--color-primary);
}

.msg-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.msg-card__title { font-size: 30rpx; font-weight: 600; flex: 1; }
.msg-card__badge {
  width: 16rpx; height: 16rpx;
  background: var(--color-danger);
  border-radius: 50%;
  margin: 8rpx 0 0 16rpx;
  flex-shrink: 0;
}
.msg-card__desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 14rpx;
  line-height: 40rpx;
}
.msg-card__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}
.msg-card__time { font-size: 22rpx; color: #bbb; }
.msg-card__more { font-size: 24rpx; color: var(--color-primary); }

.empty__icon-emoji { font-size: 120rpx; margin-bottom: 20rpx; opacity: 0.7; }
