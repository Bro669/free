<view class="page">
  <!-- 筛选 -->
  <view class="msg-filter">
    <view class="msg-filter__item {{filter==='all'?'is-active':''}}" data-filter="all" bindtap="switchFilter">全部</view>
    <view class="msg-filter__item {{filter==='unread'?'is-active':''}}" data-filter="unread" bindtap="switchFilter">未读</view>
  </view>

  <block wx:if="{{list.length}}">
    <view class="container">
      <view class="card msg-card" wx:for="{{list}}" wx:key="id" data-index="{{index}}" bindtap="onTapItem">
        <view class="msg-card__head">
          <view class="msg-card__title text-ellipsis-2">{{item.title}}</view>
          <view wx:if="{{!item.read}}" class="msg-card__badge"></view>
        </view>
        <view class="msg-card__desc text-ellipsis-2">{{item.desc}}</view>
        <view class="msg-card__foot">
          <text class="msg-card__time">{{item.time}}</text>
          <text class="msg-card__more">查看详情 ›</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 空态 -->
  <view wx:elif="{{!loading}}" class="empty">
    <view class="empty__icon-emoji">📭</view>
    <view class="empty__text">暂无消息</view>
  </view>
</view>
